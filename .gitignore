# ============================================================
#  Amazon Bot Assistant — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ---- Virtual environments ----
env/
venv/
.venv/
ENV/
env.bak/

# ---- Environment & secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- Testing & coverage ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
nosetests.xml
test-results/

# ---- Jupyter notebooks ----
.ipynb_checkpoints/
*.ipynb

# ---- ML models & large data files ----
data/
*.pkl
*.pickle
*.bin
*.pt
*.pth
*.safetensors
*.onnx
*.h5
*.hdf5
*.npy
*.npz

# ---- Qdrant local storage ----
qdrant_storage/

# ---- LangSmith / LangChain cache ----
.langchain/

# ---- Logs ----
*.log
logs/
*.out

# ---- OS files ----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ---- IDEs & editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================================================
#  Frontend (Next.js)
# ============================================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/coverage/
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# ---- Next.js build output ----
frontend/.next/
frontend/build/

# ============================================================
#  Docker
# ============================================================
# Keep docker-compose.yaml and Dockerfile tracked
# Ignore any local override files
docker-compose.override.yml
docker-compose.local.yml

# ============================================================
#  Misc
# ============================================================
# Agent scratch files
Agent/
*.tmp
*.temp
